# ============================================================================
# NeuroAlert · Frontend (Next.js) — plantilla de variables de entorno
# ============================================================================
# Copia este archivo como `.env.local` y rellena los valores. NUNCA subas tus
# archivos `.env*` (están en .gitignore); este `.env.example` es el que se versiona.
# ============================================================================

# ----------------------------------------------------------------------------
# API (backend)                                                     [REQUERIDA]
# ----------------------------------------------------------------------------
# URL base del backend. El cliente Axios la consume como `${NEXT_PUBLIC_API_URL}/api`.
# Al empezar por NEXT_PUBLIC_ queda embebida en el bundle (es pública, no pongas secretos).
#   - Local:      http://localhost:4000
#   - Desarrollo: https://miapp-dev.onrender.com
#   - Producción: https://miapp-6ex5.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# Gestionadas por la plataforma (Next.js / Render)
# ----------------------------------------------------------------------------
# Normalmente NO hace falta definirlas en local (Next.js las administra).
# En Render se configuran a nivel de servicio.
# NODE_ENV=development
# PORT=3000
